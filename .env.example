# Copie ce fichier en ".env" puis colle tes clés après le signe =  (sans espace, sans guillemets)
# Le fichier .env n'est JAMAIS envoyé sur GitHub (voir .gitignore).

# Obligatoire — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Seulement si ta clé n'est liée à aucun workspace :
ANTHROPIC_WORKSPACE_ID=

# Gratuite — https://console.cloud.google.com (YouTube Data API v3)
YOUTUBE_API_KEY=
# Optionnelles (création de nouvelles clés parfois suspendue par ces services)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optionnel : où stocker les gros fichiers (banque de clips, vidéos, cache)
# DOSSIER_DONNEES=D:\studio_dark_data
# Modèles Claude (par défaut : Haiku pour le texte, Sonnet pour la vision)
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_MODEL_TRI=claude-sonnet-5-5
